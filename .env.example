NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public ReStock WhatsApp Business number in international format, digits only.
# If omitted, WhatsApp opens its share flow instead of a direct ReStock chat.
NEXT_PUBLIC_RESTOCK_WHATSAPP_NUMBER=65XXXXXXXX

# Configure backend-only secrets with `supabase secrets set`; never expose them
# through NEXT_PUBLIC variables or commit them to Git.
# NINJAVAN_CLIENT_SECRET=
